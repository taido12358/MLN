# Postgres
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/mln

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# AI quiz generation (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# API server
PORT=3001

# Content ingestion sources (paths as seen by whatever process runs `npm run seed` —
# in Docker these are the read-only volume mount points; for local dev they are the
# real Windows paths on this machine).
PRESENTS_DIR=/data/presents
TEXTBOOKS_DIR=/data/giao-trinh
